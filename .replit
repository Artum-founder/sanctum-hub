modules = ["nodejs-18", "web"]
run = "npm start"
entrypoint = "server.js"

[nix]
channel = "stable-25_05"

[deployment]
build = ["npm", "install", "--omit=dev"]
run = ["npm", "start"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
